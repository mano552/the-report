# Copy this file to ".env" (locally) or enter these as Environment Variables
# in Hostinger hPanel. NEVER commit ".env" to git or share it.

# --- Required (both free) ---
# https://newsdata.io  -> Sign up -> API key on dashboard (free: 200 requests/day)
NEWSDATA_API_KEY=
# https://aistudio.google.com/apikey  -> Create API key (free tier)
GEMINI_API_KEY=

# --- Optional ---
# Free stock videos: https://www.pexels.com/api/  (leave blank = no videos)
PEXELS_API_KEY=
# Leave EMPTY: the agent asks Google which Flash models your key can use (recommended).
# Or force models (comma separated) — run "npm run check-keys" to see which ones work.
GEMINI_MODEL=

# --- Admin & behaviour ---
# Invent a LONG random password (20+ characters). Protects /admin and the API.
ADMIN_KEY=
PORT=3000
# How often the agent runs (cron). Default: every 3 hours
NEWS_FETCH_CRON=0 */3 * * *
# Wait between Gemini calls in ms (raise to 10000 if you see many 429 errors)
GEMINI_DELAY_MS=6000
# A run is stopped after this many minutes (default 8)
AGENT_MAX_MINUTES=8
# Stories per language per run (keep small for free limits)
MAX_PER_LANGUAGE=3
# false = AI stories are saved as DRAFT and you approve them in /admin (recommended)
# true  = AI stories go live immediately
AUTO_PUBLISH=false
