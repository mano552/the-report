# Copy this file to ".env" and fill in real values. Never commit ".env" to git.

# --- Pick ONE of the two setups below ---
#
# FREE SETUP (no cost at all): fill in ONLY NEWSDATA_API_KEY and leave
# ANTHROPIC_API_KEY blank. News is pulled directly from real Urdu-language
# sources (Jang, Dawn Urdu, BBC Urdu, etc.) and used as-is — no AI rewriting.
#
# BETTER-QUALITY SETUP (small ongoing cost): fill in BOTH keys. Claude
# rewrites the raw headlines into clean, newsroom-style Urdu.

# Get this from https://newsdata.io -> Sign Up -> your API key is shown on
# the dashboard immediately (no credit card needed, this tier is free forever).
# Free tier = 200 requests/day, more than enough for a "fetch every 3 hours" schedule.
NEWSDATA_API_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — only needed for the better-quality setup above.
# Get this from https://console.anthropic.com  (Settings -> API Keys)
# Requires adding a payment method / purchasing credits — this is NOT free.
# Leave this blank for the free setup.
ANTHROPIC_API_KEY=

# A password you invent yourself. Required in the "x-admin-key" header
# to add/edit/delete news or trigger a manual fetch. Pick something long & random.
ADMIN_KEY=change-this-to-a-long-random-password

# Port the server runs on
PORT=3000

# How often the AI agent auto-fetches fresh Urdu news, as a cron expression.
# Default below = every 3 hours. See https://crontab.guru to build your own.
NEWS_FETCH_CRON=0 */3 * * *
